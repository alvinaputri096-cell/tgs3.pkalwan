
#include <iostream>
#include <string>
using namespace std;

int main() {
    string makanan[3] = {"soto", "rawon", "pecel"};
    int harga[3] = {15000, 20000, 10000};
    string minuman[2] = {"teh", "kopi"};
    int hargaminum[2] = {3000, 5000};
    int porsi[3], porsiminum[2];
    int total;
    char ulang;

    do {
        total = 0;
        cout << "DAFTAR MAKANAN BOSKUH:" << endl;
        for (int i = 0; i < 3; i++) {
            cout << i + 1 << ". " << makanan[i] << endl;
            cout << "Harga: Rp" << harga[i] << endl;
            cout << "Masukkan jumlah porsi: ";
            cin >> porsi[i];

            total += harga[i] * porsi[i];
            cout << "Subtotal: Rp"
                 << harga[i] * porsi[i] << endl;
            cout << "------------------------" << endl;
        }
        cout << "\nDAFTAR MINUMAN E BOSKU:" << endl;

        for (int i = 0; i < 2; i++) {
            cout << i + 1 << ". " << minuman[i] << endl;
            cout << "Harga: Rp" << hargaminum[i] << endl;
            cout << "Masukkan jumlah gelas: ";
            cin >> porsiminum[i];
            total += hargaminum[i] * porsiminum[i];
            cout << "Subtotal: Rp"
                 << hargaminum[i] * porsiminum[i] << endl;
            cout << "------------------------" << endl;
        }
        cout << "\nTOTAL PEMBAYARAN: Rp" << total << endl;
        cout << "\nApakah ingin mengulang? (y/n): ";
        cin >> ulang;

    } while (ulang == 'y' || ulang == 'Y');
    cout << "Terima kasih telah berbelanja!" << endl;
    return 0;
}
